# ---------------------------------------------------------------- server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Required in production: startup fails on the development default or a secret
# shorter than 32 characters.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Comma-separated browser origins allowed by CORS. Required in production;
# empty reflects the request origin, which is fine for local development.
CORS_ORIGINS=

# ------------------------------------------------------------- database ----
# Empty runs the embedded Postgres (PGlite) from ./.data/pg — no setup needed.
# Set it to use a Postgres server; docker compose sets it for you.
DATABASE_URL=
# DATABASE_URL=postgres://payroll:payroll@localhost:5432/payroll
PGLITE_DIR=
PG_POOL_MAX=10

# ---------------------------------------------------------------- queue ----
# Empty runs the in-process queue. Set it to use BullMQ + Redis, which also
# enables the standalone worker process.
REDIS_URL=
# REDIS_URL=redis://localhost:6379
QUEUE_NAME=payroll-jobs
# With Redis configured, does the API process also consume jobs?
INLINE_WORKER=true
# Payroll jobs processed at the same time by one process.
MAX_PARALLEL_JOBS=2

# ----------------------------------------------------- processing engine ----
# Timesheet rows validated in parallel within a job.
WORKER_CONCURRENCY=8
# Simulated per-row cost, standing in for the rule lookups a real system does.
# Set to 0 to remove it.
ROW_PROCESSING_DELAY_MS=4
# Attempts before a row is recorded as a processing failure.
ROW_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=25
UPLOAD_RATE_LIMIT_PER_MIN=10

# --------------------------------------- default overtime rules per org -----
# Overridable per organisation in Settings, and per upload.
OT_DAILY_THRESHOLD=8
OT_WEEKLY_THRESHOLD=40
OT_MULTIPLIER=1.5

# -------------------------------------------------------------- logging ----
LOG_LEVEL=info
# Human-readable logs; set false for JSON (the default in production).
LOG_PRETTY=true

# --------------------------------------------------------------- serving ----
# The API serves the built SPA when web/dist exists. Set false to disable.
SERVE_WEB=true
# WEB_DIST=/app/web/dist
