# ---- Server ----
PORT=4000
NODE_ENV=development

# JWT signing secret (CHANGE IN PRODUCTION)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h

# Database.
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) at ./.data/pg — zero setup.
# Set it to run against a real Postgres server (docker compose sets this automatically).
DATABASE_URL=
# DATABASE_URL=postgres://payroll:payroll@localhost:5432/payroll

# Queue.
# Leave REDIS_URL empty to use the in-process queue driver.
# Set it to use BullMQ + Redis with a separate worker process.
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# ---- Processing engine ----
# Number of rows processed in parallel by the worker pool
WORKER_CONCURRENCY=8
# Simulated per-row processing cost (ms) so concurrency actually matters
ROW_PROCESSING_DELAY_MS=4
# Per-row retry attempts before a row is marked as a processing failure
ROW_MAX_ATTEMPTS=3
# Max upload size in MB
MAX_UPLOAD_MB=25
# Uploads allowed per user per minute
UPLOAD_RATE_LIMIT_PER_MIN=10

# ---- Default payroll rules (overridable per organization and per upload) ----
OT_DAILY_THRESHOLD=8
OT_WEEKLY_THRESHOLD=40
OT_MULTIPLIER=1.5

# ---- Logging ----
LOG_LEVEL=info
LOG_PRETTY=true
